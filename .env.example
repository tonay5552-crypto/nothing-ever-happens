# Deployment mode (secrets and toggles only — everything else is in config.json)
# BOT_MODE: "paper" (default, safe) or "live" (requires all three flags below + secrets)
BOT_MODE=paper
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# Secrets
PRIVATE_KEY=
# Required for signature_type 1 or 2 live accounts
FUNDER_ADDRESS=
# Required for BOT_MODE=live
DATABASE_URL=
# Required for proxy-wallet approval bootstrap in live signature_type=2 mode
POLYGON_RPC_URL=

# Config file path (default: config.json)
# CONFIG_PATH=config.json

# Dashboard bind address (default: 0.0.0.0) and port ($PORT or DASHBOARD_PORT, default 8080)
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080

# Backtest / autoresearch
# Directory containing downloaded Parquet data from jon-becker/prediction-market-analysis
# POLYMARKET_DATA_DIR=data/polymarket
# OPTIMIZER_WORK_DIR=artifacts/optimizer
